{
  "name": "accessible-todo-sass",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible responsive To-Do List built with Sass and vanilla JavaScript",
  "scripts": {
    "sass:dev": "sass --watch scss/main.scss:dist/css/main.css --source-map",
    "build": "sass scss/main.scss dist/css/main.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.93.2"
  }
}

